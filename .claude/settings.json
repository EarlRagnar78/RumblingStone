{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/vincolo_skill.py --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/memoria_custode.py --hook-scrittura",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/memoria_custode.py --hook-merge",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_pull_request|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__create_branch|mcp__github__merge_pull_request|mcp__github__update_pull_request_branch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/instradamento_agenti.py --cancello",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/instradamento_agenti.py --prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/instradamento_agenti.py --stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agentic-council@synced": false,
    "ai-governance-legal@synced": false,
    "ai-mentor@synced": false,
    "bio-research@synced": false,
    "claude-for-msft-365-install@synced": false,
