{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx", "--from", "serena-agent", "serena", "start-mcp-server",
        "--project-from-cwd", "--context", "agent", "--open-web-dashboard", "False"
      ],
      "enabled": true,
      "timeout": 60000
    }
  }
}
